# === minio — пример окружения (скопировать в .env; .env НЕ коммитить) ===
#
# ВАЖНО про формат: docker compose трактует всё после первого "=" как значение.
# Кавычки вокруг значения станут ЧАСТЬЮ значения — не оборачивайте пароль в кавычки.
# Комментарий в строке с пустым значением тоже попадёт в значение — комментируйте строкой выше.

# --- Учётные данные администратора хранилища -----------------------------------------
# 🔴 ОБЯЗАТЕЛЬНЫ, дефолтов намеренно нет: без них compose откажется стартовать с внятной
# ошибкой. Раньше в docker-compose.yml стояли minioadmin/minioadmin — при запуске без
# параметров хранилище поднималось с общеизвестной парой. Проверьте, что на работающих
# установках пароль не остался дефолтным, и смените, если остался.
#
# Ограничения MinIO (проверено на RELEASE.2025-09-07): логин ≥ 3 символов, пароль ≥ 8.
# Если короче — контейнер падает при старте без внятного сообщения.
# Сгенерировать пароль: openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Регион ---------------------------------------------------------------------------
# Клиенты S3 подписывают запросы регионом, поэтому менять его на работающем хранилище
# нельзя без согласования: разъедется подпись у всех, кто уже настроен на прежний.
MINIO_REGION=kz-ala-dev

# --- Бакеты, создаваемые при старте ---------------------------------------------------
# Список через запятую. Создаёт сервис minio-init (сам MinIO этого не умеет: переменная
# MINIO_DEFAULT_BUCKETS относится к образу bitnami, официальный её игнорирует).
# Создание идемпотентно: существующие бакеты и их содержимое не трогаются.
#
# chat-attachments (HAP-535) — вложения и голосовые внутреннего чата операторов (HAP-528).
# Отдельный бакет, а не подпапка в registry: у чата свой жизненный цикл и свой владелец
# данных, а разделение по бакетам — единственная граница, которую понимает политика MinIO
# (префиксных прав в наших политиках нет). Смешав их, мы выдали бы чату доступ к реестрам.
#
# documents (HAP-535) — диск `s3documents` в CRM существует и объявлен в её OpenAPI как
# допустимое значение `?disk=`, а бакета под него в хранилище не было ни одного дня: имя
# лежит в устаревшем crm/.env.example и не доехало ни до актуального crm/env.example, ни
# сюда. Диск указывал в никуда, запрос падал. Бакет заводим — это дешевле, чем выяснять,
# кто из клиентов уже шлёт `?disk=s3documents`.
# ⚠️ Не путать с бакетом `documents` сервиса file_service: у того СВОЙ MinIO (контейнер
# `storage`, отдельный volume и сеть, наружу не публикуется). Имена совпадают, хранилища
# разные — здесь речь только про это, общее.
MINIO_BUCKETS=registry,record,whatsapp,documents,chat-attachments

# --- Сервисный аккаунт CRM (HAP-509) --------------------------------------------------
# Узкая учётка для CRM вместо root-кредов выше. Сейчас CRM ходит в хранилище именно
# root'ом: тот же секрет лежит и здесь, и в crm/.env, то есть тот, кто катит CRM, владеет
# хранилищем целиком — вместе с записями разговоров и файлами WhatsApp.
#
# Аккаунт заводит _docker/init.sh при каждой выкатке: пользователь + политика ровно на
# перечисленные ниже бакеты, без admin-прав, без создания и удаления бакетов.
#
# 🟡 Значения НЕ заполняются руками на хосте. Источник — Credentials Store папки `crm`
#    в Jenkins (`crm-minio-access-key` / `crm-minio-secret-key`), а разносит их выкатка:
#    envSecrets в Jenkinsfile → .env на хосте (jenkins-infra/DEPLOY.md §10). Копипаста
#    между .env разных сервисов и породила общий секрет, который мы сейчас расшиваем.
#    Пустые значения допустимы: аккаунт тогда не заводится, бакеты создаются как обычно.
#
# Ограничения MinIO те же: access key ≥ 3 символов, secret key ≥ 8.
MINIO_CRM_ACCESS_KEY=
MINIO_CRM_SECRET_KEY=

# Бакеты, доступные сервисному аккаунту. 🟡 Список обязан совпадать с AWS_BUCKET /
# AWS_RECORDS_BUCKET / AWS_WHATSAPP_BUCKET / AWS_DOCUMENTS_BUCKET / AWS_CHAT_BUCKET в
# окружении CRM — иначе приложение получит AccessDenied на бакете, которого нет в политике.
# Менять согласованно с crm-backend.
#
# Все четыре диска CRM (`s3`, `s3records`, `s3whatsapp`, `s3documents`) и новый `s3chat`
# ходят одними и теми же AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY — то есть одной учёткой
# `crm-app`. Поэтому список здесь = список бакетов CRM, один в один.
#
# chat-attachments (HAP-535) отдаётся той же учётке, а не новой: аккаунт здесь заводится
# на СЕРВИС, а не на бакет, и потребитель у чата ровно один — CRM (стримит файл участникам
# чата сама, HAP-531). Отдельная пара ключей добавила бы третий секрет к ротации, ничего
# при этом не изолировав.
MINIO_CRM_BUCKETS=registry,record,whatsapp,documents,chat-attachments

# Имя политики в MinIO. Менять незачем; вынесено, чтобы не было константы в скрипте.
MINIO_CRM_POLICY=crm-app

# --- Сервисный аккаунт телефонии (HAP-516) --------------------------------------------
# Узкая учётка для telephony-ari вместо root-кредов. До HAP-516 сервис ходил в хранилище
# администратором: `hd-minio-admin` и MINIO_ROOT_PASSWORD лежали у него в .env.secrets
# (сверено по sha256 13.08.2026). А складывает он туда записи разговоров — ПДн высокой
# чувствительности. Пока root оставался у потребителя, его нельзя было и ротировать:
# ротация просто ломала запись и выдачу разговоров (HAP-517 ждал именно этого).
#
# 🟡 Значения НЕ заполняются руками на хосте. Источник — Credentials Store папки `crm`
#    (`minio-telephony-access-key` / `minio-telephony-secret-key`), разносит выкатка.
#    ⚠️ Те же значения обязаны лежать в credential'е `telephony-ari-staging-env` папки
#    `telephony` — это второй конец той же пары. Ротация меняет ОБА (DEPLOY.md §10).
#    Пустые значения допустимы: аккаунт тогда не заводится, бакеты создаются как обычно.
MINIO_TELEPHONY_ACCESS_KEY=
MINIO_TELEPHONY_SECRET_KEY=

# Бакет(ы) записей разговоров. 🟡 Должен совпадать с MINIO_BUCKET в окружении
# telephony-ari и с AWS_RECORDS_BUCKET у CRM, которая эти записи отдаёт оператору.
# Менять согласованно с владельцами обоих сервисов.
MINIO_TELEPHONY_BUCKETS=record

# Имя политики в MinIO.
MINIO_TELEPHONY_POLICY=telephony-ari

# --- Сервисный аккаунт файлового сервиса (HAP-620) ------------------------------------
# file_service переезжает со своего отдельного MinIO (контейнер `file-s3` в его
# docker-compose, на том же vm-stage) сюда. Решение — рекомендация architect-orchestrator
# в HAP-609: раздельные инстансы давали не изоляцию, а второй цикл патчинга, бэкапа и
# мониторинга на той же машине и том же диске; граница данных проходит по бакету и
# политике, а не по числу процессов.
#
# 🟡 Значения НЕ заполняются руками на хосте. Источник — Credentials Store папки `crm`
#    (`minio-files-access-key` / `minio-files-secret-key`), разносит выкатка (DEPLOY.md
#    §10). Те же значения уезжают в STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY окружения
#    file_service — это второй конец пары, ротация меняет ОБА.
#    Пустые значения допустимы: аккаунт не заводится, бакет всё равно создаётся.
MINIO_FILES_ACCESS_KEY=
MINIO_FILES_SECRET_KEY=

# Бакет файлового сервиса. 🔴 Отдельный, а не общий `documents`: тот заведён под диск
# `s3documents` CRM и входит в политику `crm-app` — сложив документы должников туда, мы бы
# выдали CRM право читать и удалять их напрямую, мимо владельца данных. После HAP-609 CRM
# ходит за этими файлами через API file_service, прямой доступ к бакету ей не нужен.
#
# ⚠️ Этого бакета намеренно НЕТ в MINIO_BUCKETS: там список, который по умолчанию
# наследует политика CRM (MINIO_CRM_BUCKETS), и попадание в него — ровно та утечка прав,
# от которой мы уходим. Бакет создаёт секция file_service в _docker/init.sh.
#
# 🟡 Должен совпадать с STORAGE_BUCKET в окружении file_service. Менять согласованно с
# владельцем сервиса (file-service-go).
MINIO_FILES_BUCKETS=file-service

# Имя политики в MinIO.
MINIO_FILES_POLICY=file-service

# Срок хранения объектов в бакете file_service, в днях. Пусто = правило не ставится.
#
# 🔴 ПУСТ намеренно, и это не недоделка. Автоудаление документа должника необратимо: срок
# должен прийти из регламента хранения, а не из дефолта в конфиге. Retention записей
# разговоров тут не образец — у документов он свой. Пока значение пусто, MinIO не удаляет
# ничего; заполнить = включить удаление на следующей же выкатке.
#
# Про брошенные multipart-загрузки правило не нужно: MinIO не принимает такое действие в
# lifecycle вовсе, а убирает их сам — `mc admin config get <alias> api` показывает
# stale_uploads_expiry=24h, stale_uploads_cleanup_interval=6h.
MINIO_FILES_EXPIRE_DAYS=

# --- Порты и привязка -----------------------------------------------------------------
# S3 API.
MINIO_API_PORT=9000
MINIO_API_BIND=0.0.0.0
# Веб-консоль (админка хранилища).
# ⚠️ 0.0.0.0 означает «доступна со всей сети». Если хост виден за пределами доверенного
# контура — поставьте 127.0.0.1 и ходите через SSH-туннель:
#   ssh -L 9001:127.0.0.1:9001 prog@<хост>
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_BIND=0.0.0.0

# --- Веб-интерфейс --------------------------------------------------------------------
# on | off. off полностью отключает консоль (тогда привязка выше не важна).
MINIO_BROWSER=on
