# === minio — пример окружения (скопировать в .env; .env НЕ коммитить) ===
#
# ВАЖНО про формат: docker compose трактует всё после первого "=" как значение.
# Кавычки вокруг значения станут ЧАСТЬЮ значения — не оборачивайте пароль в кавычки.
# Комментарий в строке с пустым значением тоже попадёт в значение — комментируйте строкой выше.

# --- Учётные данные администратора хранилища -----------------------------------------
# 🔴 ОБЯЗАТЕЛЬНЫ, дефолтов намеренно нет: без них compose откажется стартовать с внятной
# ошибкой. Раньше в docker-compose.yml стояли minioadmin/minioadmin — при запуске без
# параметров хранилище поднималось с общеизвестной парой. Проверьте, что на работающих
# установках пароль не остался дефолтным, и смените, если остался.
#
# Ограничения MinIO (проверено на RELEASE.2025-09-07): логин ≥ 3 символов, пароль ≥ 8.
# Если короче — контейнер падает при старте без внятного сообщения.
# Сгенерировать пароль: openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Регион ---------------------------------------------------------------------------
# Клиенты S3 подписывают запросы регионом, поэтому менять его на работающем хранилище
# нельзя без согласования: разъедется подпись у всех, кто уже настроен на прежний.
MINIO_REGION=kz-ala-dev

# --- Бакеты, создаваемые при старте ---------------------------------------------------
# Список через запятую. Создаёт сервис minio-init (сам MinIO этого не умеет: переменная
# MINIO_DEFAULT_BUCKETS относится к образу bitnami, официальный её игнорирует).
# Создание идемпотентно: существующие бакеты и их содержимое не трогаются.
MINIO_BUCKETS=registry,record,whatsapp

# --- Сервисный аккаунт CRM (HAP-509) --------------------------------------------------
# Узкая учётка для CRM вместо root-кредов выше. Сейчас CRM ходит в хранилище именно
# root'ом: тот же секрет лежит и здесь, и в crm/.env, то есть тот, кто катит CRM, владеет
# хранилищем целиком — вместе с записями разговоров и файлами WhatsApp.
#
# Аккаунт заводит _docker/init.sh при каждой выкатке: пользователь + политика ровно на
# перечисленные ниже бакеты, без admin-прав, без создания и удаления бакетов.
#
# 🟡 Значения НЕ заполняются руками на хосте. Источник — Credentials Store папки `crm`
#    в Jenkins (`crm-minio-access-key` / `crm-minio-secret-key`), а разносит их выкатка:
#    envSecrets в Jenkinsfile → .env на хосте (jenkins-infra/DEPLOY.md §10). Копипаста
#    между .env разных сервисов и породила общий секрет, который мы сейчас расшиваем.
#    Пустые значения допустимы: аккаунт тогда не заводится, бакеты создаются как обычно.
#
# Ограничения MinIO те же: access key ≥ 3 символов, secret key ≥ 8.
MINIO_CRM_ACCESS_KEY=
MINIO_CRM_SECRET_KEY=

# Бакеты, доступные сервисному аккаунту. 🟡 Список обязан совпадать с AWS_BUCKET /
# AWS_RECORDS_BUCKET / AWS_WHATSAPP_BUCKET в окружении CRM — иначе приложение получит
# AccessDenied на бакете, которого нет в политике. Менять согласованно с crm-backend.
MINIO_CRM_BUCKETS=registry,record,whatsapp

# Имя политики в MinIO. Менять незачем; вынесено, чтобы не было константы в скрипте.
MINIO_CRM_POLICY=crm-app

# --- Порты и привязка -----------------------------------------------------------------
# S3 API.
MINIO_API_PORT=9000
MINIO_API_BIND=0.0.0.0
# Веб-консоль (админка хранилища).
# ⚠️ 0.0.0.0 означает «доступна со всей сети». Если хост виден за пределами доверенного
# контура — поставьте 127.0.0.1 и ходите через SSH-туннель:
#   ssh -L 9001:127.0.0.1:9001 prog@<хост>
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_BIND=0.0.0.0

# --- Веб-интерфейс --------------------------------------------------------------------
# on | off. off полностью отключает консоль (тогда привязка выше не важна).
MINIO_BROWSER=on
